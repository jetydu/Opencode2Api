<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 配置（对应 Go 版 telemetry 包的 slog TextHandler 行为）。
  - 控制台彩色输出，文件按天滚动并保留 14 天；
  - 结构化字段由 StructuredLogger 拼好，这里只加时间/级别前缀；
  - 框架内部日志（Kestrel、HttpClient）全部丢弃，避免刷屏。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Off">

  <variable name="logDirectory" value="${basedir}/logs"/>

  <targets async="true">
    <target xsi:type="ColoredConsole" name="console"
            layout="${date:format=HH\:mm\:ss.fff} ${level:uppercase=true:padding=-5} ${message}${onexception:inner= ${exception:format=tostring}}"/>
    <target xsi:type="File" name="file"
            fileName="${logDirectory}/opencode2api.log"
            archiveFileName="${logDirectory}/opencode2api-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveDays="14"
            keepFileOpen="false"
            autoFlush="true"
            encoding="utf-8"
            layout="${longdate} ${level:uppercase=true:padding=-5} ${message}${onexception:inner= ${exception:format=tostring}}"/>
  </targets>

  <rules>
    <!-- 丢弃 ASP.NET Core 与 HttpClient 的噪声日志。 -->
    <logger name="Microsoft.*" minLevel="Trace" final="true"/>
    <logger name="System.Net.Http.*" minLevel="Trace" final="true"/>
    <logger name="*" minLevel="Trace" writeTo="console"/>
    <logger name="*" minLevel="Trace" writeTo="file"/>
  </rules>
</nlog>
